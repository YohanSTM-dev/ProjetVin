<Window x:Class="ProjetCaveVin.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetCaveVin.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <local:BoutielleViewModel/>
    </Window.DataContext>

    <StackPanel Margin="20">
        <TextBlock Text="Nom de la bouteille :" />
        <TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

        <TextBlock Text="Millésime :" />
        <TextBox Text="{Binding Millesime, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

        <Button Content="Ajouter Bouteille" Command="{Binding AjouterBouteilleCommand}" Margin="0,10"/>

        <ListBox ItemsSource="{Binding Bouteilles}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Id}" Width="30"/>
                        <TextBlock Text="{Binding Nom}" Width="200"/>
                        <TextBlock Text="{Binding Millesime}" Width="100"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Window>
