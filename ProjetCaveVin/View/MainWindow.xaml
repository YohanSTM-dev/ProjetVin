<Window x:Class="ProjetCaveVin.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetCaveVin.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Tester la connexion" Width="200" Height="40" Command="{Binding TestConnexionCommand}" Click="Button_Click_1" />

            <!-- TextBox en lecture seule pour afficher le résultat -->
            <TextBox Text="{Binding Resultat}" Margin="0,20,0,0" FontSize="16" 
             TextAlignment="Center" IsReadOnly="True"/>
        </StackPanel>
    </Grid>
</Window>
