<Window x:Class="ProjetCaveVin.View.LoginAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Grand Monarque - Administration"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8F8F8">

    <Window.Resources>

        <!-- Boutons principaux -->
        <Style x:Key="AdminButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#B8860B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Carte centrale -->
        <Border Width="420"
                Padding="40"
                Background="White"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#DDD"
                BorderThickness="1">

            <StackPanel>

                <!-- En-tête -->
                <TextBlock Text="Administration"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Accès sécurisé Grand Monarque"
                           FontSize="13"
                           Foreground="Gray"
                           Margin="0,5,0,30"
                           HorizontalAlignment="Center"/>

                <!-- Séparateur -->
                <Border Height="1"
                        Background="#EEE"
                        Margin="0,0,0,30"/>

                <!-- Actions -->
                <Button Content="Se connecter"
        Style="{StaticResource AdminButtonStyle}"
        Click="ConnexionButton_Click"/>
                <Button Content="Créer un compte administrateur"
        Style="{StaticResource AdminButtonStyle}"
        Background="#555"
        Click="InscriptionButton_Click"/>

                <Button Content="← Retour"
        Background="Transparent"
        Foreground="#B8860B"
        BorderThickness="0"
        FontSize="14"
        Margin="0,10,0,0"
        HorizontalAlignment="Center"
        Cursor="Hand"
        Click="RetourButton_Click"/>


            </StackPanel>
        </Border>

        <!-- Bande décorative -->
        <Border Height="6"
                VerticalAlignment="Top">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#000000" Offset="0"/>
                    <GradientStop Color="#B8860B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

    </Grid>
</Window>
