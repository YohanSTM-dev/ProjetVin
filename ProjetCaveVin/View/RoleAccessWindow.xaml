<Window x:Class="ProjetCaveVin.View.RoleAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ProjetCaveVin.ViewModel"
        mc:Ignorable="d"
        Title="Grand Monarque - Accès Sécurisé" 
        Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <Style x:Key="RoleRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B8860B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#B8860B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#222">
            <Grid>
                <Border Opacity="0.8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#000000" Offset="0"/>
                            <GradientStop Color="#422509" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="GRAND" Foreground="White" FontSize="30" FontWeight="Light" HorizontalAlignment="Center" />
                    <TextBlock Text="MONARQUE" Foreground="#B8860B" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="GESTION DE CAVE" Foreground="#CCC" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="50">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Connexion" FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,5"/>
                <TextBlock Text="Veuillez sélectionner votre profil d'accès" FontSize="14" Foreground="Gray" Margin="0,0,0,30"/>

                <TextBlock Text="QUI ÊTES-VOUS ?" FontSize="12" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,10"/>

                <UniformGrid Columns="3" Height="60" Margin="0,0,0,30">
                    <RadioButton Content="Sommelier" 
                                 GroupName="Roles"
                                 Style="{StaticResource RoleRadioButtonStyle}"
                                 Command="{Binding SelectRoleCommand}"
                                 CommandParameter="Sommelier"/>

                    <RadioButton Content="Serveur" 
                                 GroupName="Roles"
                                 Style="{StaticResource RoleRadioButtonStyle}"
                                 Command="{Binding SelectRoleCommand}"
                                 CommandParameter="Serveur"/>

                    <RadioButton Content="Admin" 
                                 GroupName="Roles"
                                 Style="{StaticResource RoleRadioButtonStyle}"
                                 Command="{Binding SelectRoleCommand}"
                                 CommandParameter="Administrateur"/>
                </UniformGrid>

                <TextBlock Text="MOT DE PASSE" FontSize="12" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,10"/>

                <PasswordBox x:Name="RolePasswordBox"
                             Height="45"
                             FontSize="16"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             BorderBrush="#DDD"
                             BorderThickness="1"
                             Background="#FAFAFA"
                             Margin="0,0,0,10"/>

                <TextBlock Text="{Binding Message}" 
                           Foreground="#D32F2F" 
                           FontSize="13" 
                           Height="20"
                           Margin="0,0,0,20"/>

                <Button Content="SE CONNECTER"
                        Height="50"
                        FontSize="16" FontWeight="Bold"
                        Foreground="White"
                        Background="#B8860B"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ValidateRoleCommand}"
                        CommandParameter="{Binding ElementName=RolePasswordBox}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="{Binding SelectedRoleName, StringFormat='Rôle sélectionné : {0}'}" />

            </StackPanel>
        </Grid>
    </Grid>
</Window>