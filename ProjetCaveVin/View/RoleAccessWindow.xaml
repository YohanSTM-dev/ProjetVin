<Window x:Class="ProjetCaveVin.View.RoleAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélection du rôle" Height="300" Width="400">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

            <TextBlock Text="Choisissez votre rôle :" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Serveur" Tag="Serveur" Click="RoleButton_Click" Width="90" />
                <Button Content="Sommelier" Tag="Sommelier" Click="RoleButton_Click" Width="90" />
                <Button Content="Administrateur" Tag="Administrateur" Click="RoleButton_Click" Width="110" />
            </StackPanel>

            <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock x:Name="SelectedRoleText" Text="Rôle sélectionné: " FontWeight="Bold" />
                <PasswordBox x:Name="RolePasswordBox" Margin="0,6,0,0" />
                <Button Content="Valider" Click="ValidateRoleAccess_Click" Margin="0,8,0,0" />
                <TextBlock x:Name="MessageText" Foreground="Red" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
