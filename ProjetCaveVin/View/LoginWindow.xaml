<Window x:Class="ProjetCaveVin.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetCaveVin.View"
        mc:Ignorable="d"
        Title="Connexion - Sélection du rôle"
        Height="450" Width="800">

	<Grid Margin="20">
		<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">

			<StackPanel x:Name="LoginPanel" Margin="0,20,0,0">
				<TextBlock Text="Email:"/>
				<TextBox x:Name="EmailBox" Margin="0,4,0,0"/>

				<TextBlock Text="Mot de passe:" Margin="0,8,0,0"/>
				<PasswordBox x:Name="PasswordBox" Margin="0,4,0,0"/>

				<Button Content="Se connecter" Click="LoginButton_Click" Margin="0,10,0,0"/>
				<TextBlock x:Name="MessageText" Foreground="Red" Margin="0,6,0,0"/>

				<Button Content="Retour" Click="RetourButton_Click" Margin="0,10,0,0"/>	
			</StackPanel>

		</StackPanel>
	</Grid>
</Window>
