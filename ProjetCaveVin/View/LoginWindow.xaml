<Window x:Class="ProjetCaveVin.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetCaveVin.View"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Cursor="">

            <!-- Email -->
            <TextBlock Text="Email :" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Email}" Height="30" Margin="0,0,0,10"/>

            <!-- Password -->
            <TextBlock Text="Mot de passe :" FontWeight="Bold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="30" Margin="0,0,0,10"/>

            <!-- Bouton de connexion -->
            <Button Content="Se connecter" Height="35" Command="{Binding LoginCommand}" Margin="0,0,0,10" Click="Button_Click"/>

            <Button Content="S'inscrire" Width="200" Height="40" Margin="0,10,0,0" Click="InscriptionButton_Click"/>


            <!-- Message d'erreur / succès -->
            <TextBlock Text="{Binding Message}" Foreground="Red" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />

        </StackPanel>


    </Grid>
</Window>
