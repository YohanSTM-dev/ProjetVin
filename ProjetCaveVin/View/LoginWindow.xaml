<Window x:Class="ProjetCaveVin.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProjetCaveVin.ViewModel"
        Title="Connexion"
        Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F8F8">

	<Window.DataContext>
		<vm:LoginViewModel />
	</Window.DataContext>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Titre -->
		<TextBlock Text="Connexion"
				   FontSize="22"
				   FontWeight="Bold"
				   Foreground="#5A0010"
				   HorizontalAlignment="Center"
				   Margin="0,0,0,20"/>

		<!-- Email -->
		<TextBlock Text="Email :"
				   Grid.Row="1"
				   FontWeight="SemiBold"/>
		<TextBox Grid.Row="2"
				 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
				 Margin="0,5,0,15"
				 Height="28"
				 Padding="5"/>

		<!-- Mot de passe -->
		<TextBlock Text="Mot de passe :"
				   Grid.Row="3"
				   FontWeight="SemiBold"/>
		<PasswordBox Grid.Row="4"
					 x:Name="PasswordBox"
					 Margin="0,5,0,15"
					 Height="28"
					 Padding="5"
					 PasswordChanged="PasswordBox_PasswordChanged"/>

		<!-- Message -->
		<TextBlock Text="{Binding Message}"
				   Grid.Row="5"
				   Foreground="Red"
				   FontSize="12"
				   Margin="0,5,0,10"
				   TextWrapping="Wrap"/>

		<!-- Boutons -->
		<StackPanel Grid.Row="6"
					Orientation="Horizontal"
					HorizontalAlignment="Center"
					Margin="0,10,0,0"
                >
			<Button Content="Connexion"
					Width="100"
					Command="{Binding LoginCommand}"
					Background="#5A0010"
					Foreground="White"
					FontWeight="Bold"/>
			<Button Content="Retour"
					Width="100"
					Click="RetourButton_Click"/>
		</StackPanel>
	</Grid>

</Window>
