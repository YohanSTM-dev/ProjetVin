<Window x:Class="ProjetCaveVin.Views.GestionStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion du Stock"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- ============================= -->
        <!-- 🔴 GESTION DES BOUTEILLES -->
        <!-- ============================= -->

        <StackPanel Grid.Column="0" Margin="10">

            <TextBlock Text="Gestion des Bouteilles"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding NombreBouteilles, StringFormat=Nombre total : {0}}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <ListBox ItemsSource="{Binding Bouteilles}"
                     SelectedItem="{Binding BouteilleSelectionnee}"
                     Height="200"
                     DisplayMemberPath="Libelle"/>

            <TextBlock Text="Libellé" Margin="0,10,0,0"/>
            <TextBox x:Name="TxtLibelle"/>

            <TextBlock Text="Millésime" Margin="0,10,0,0"/>
            <TextBox x:Name="TxtMillesime"/>

            <TextBlock Text="Zone" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding Zones}"
                      SelectedItem="{Binding ZoneSelectionnee}"
                      DisplayMemberPath="Nom"/>

            <TextBlock Text="Emplacement" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding Emplacements}"
                      SelectedItem="{Binding EmplacementSelectionne}"
                      DisplayMemberPath="Code"/>

            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Button Content="Ajouter"
                        Width="100"
                        Margin="0,0,10,0"
                        Command="{Binding AjouterBouteilleCommand}"/>
                <Button Content="Supprimer"
                        Width="100"
                        Command="{Binding SupprimerBouteilleCommand}"/>
            </StackPanel>

        </StackPanel>

        <!-- ============================= -->
        <!-- 🔵 GESTION DES EMPLACEMENTS -->
        <!-- ============================= -->

        <StackPanel Grid.Column="1" Margin="10">

            <TextBlock Text="Gestion des Emplacements"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <ListBox ItemsSource="{Binding Emplacements}"
                     SelectedItem="{Binding EmplacementSelectionne}"
                     Height="200"
                     DisplayMemberPath="Code"/>

            <TextBlock Text="Code emplacement" Margin="0,10,0,0"/>
            <TextBox x:Name="TxtCodeEmplacement"/>

            <TextBlock Text="Capacité" Margin="0,10,0,0"/>
            <TextBox x:Name="TxtCapacite"/>

            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Button Content="Ajouter"
                        Width="100"
                        Margin="0,0,10,0"
                        Command="{Binding AjouterEmplacementCommand}"/>
                <Button Content="Supprimer"
                        Width="100"
                        Command="{Binding SupprimerEmplacementCommand}"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Window>