<Page x:Class="ProjetCaveVin.View.GestionBouteillePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:ProjetCaveVin.Model"
      Title="Gestion des Bouteilles"
      Background="#FFFDFDFD">

    <Page.Resources>
        <!-- Ombre de base pour les cartes -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>

        <!-- Style pour les cartes -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Logo et titre -->
            <RowDefinition Height="Auto"/>
            <!-- Bouton recharger -->
            <RowDefinition Height="*"/>
            <!-- Cartes -->
        </Grid.RowDefinitions>

        <!-- Ligne 0 : Logo et titre -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Logo -->
                <ColumnDefinition Width="*"/>
                <!-- Titre -->
            </Grid.ColumnDefinitions>

            <!-- Logo à gauche -->
            <Image Source="Images/logogmcomplet.png"
                   Grid.Column="0"
                   Height="120"
                   Width="250"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

            <!-- Titre à droite du logo -->
            <TextBlock Text="Liste des bouteilles"
                       Grid.Column="1"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="20,0,0,0"/>
        </Grid>

        <!-- Ligne 1 : bouton recharger -->
        <Button Grid.Row="1"
                Content="Recharger les bouteilles"
                Width="220"
                Height="40"
                HorizontalAlignment="Left"
                Margin="0,0,0,20"
                Click="Recharger_Click"/>

        <!-- Ligne 2 : ScrollViewer avec cartes -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Bouteilles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Libelle}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Prix, StringFormat={}{0:F2} €}"
                                           FontSize="14"
                                           Foreground="DarkRed"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Type}"
                                           FontSize="13"
                                           Foreground="Gray"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding Code, StringFormat=Zone : {0}}"
                                           FontSize="12"
                                           Foreground="Gray"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding Code_Emplacement, StringFormat=Emplacement : {0}}"
                                           FontSize="12"
                                           Foreground="Gray"
                                           TextAlignment="Center"/>
                                <Image Width="200" Source="{Binding Photo}" />


                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>