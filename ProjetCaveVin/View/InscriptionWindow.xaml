<Window x:Class="ProjetCaveVin.View.InscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetCaveVin.View"
        mc:Ignorable="d"
        Title="InscriptionWindow" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel>
			<TextBlock Text="Nom" />
			<TextBox Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

			<TextBlock Text="Prénom" />
			<TextBox Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

			<TextBlock Text="Email" />
			<TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>

			<TextBlock Text="Rôle" />
			<ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Margin="0,5"/>


			<TextBlock Text="Mot de passe" />
			<PasswordBox x:Name="PasswordBox" Margin="0,5"/>

			<Button Content="Inscription" Margin="0,10" Click="InscriptionButton_Click"/>

			<TextBlock Text="{Binding Message}" Foreground="Red" Margin="0,5"/>

            <Button Content=" Retour " Click="RetourButton_Click"/>
            
        </StackPanel>
    </Grid>
</Window>
