<Window x:Class="ProjetCaveVin.View.AdministrateurWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetCaveVin.View"
        mc:Ignorable="d"
        Title="AdministrateurWindow" Height="450" Width="800">

	<Grid>
		<Label Content="Page et vision Administrateur"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               FontSize="16"
               Margin="0,20,0,0"/>

		<StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    >

			<Button Content="Gestion bouteilles"
                    Width="150"
                    Height="40"
                    Background="#5A0010"
                    Foreground="White"
					Command ="{Binding ShowGestionBouteillesCommand }" />

			<Button Content="Stats GrandMonarque"
                    Width="150"
                    Height="40"
                    Background="#333333"
                    Foreground="White"
					Command="{Binding ShowStatistiquesGrandMonarqueCommand}"/>
		</StackPanel>
	</Grid>
</Window>
