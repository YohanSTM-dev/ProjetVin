<Window x:Class="ProjetCaveVin.View.StatistiquesGrandMonarqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestion des Stocks - Grand Monarque"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="CAVE GRAND MONARQUE" FontSize="24" FontWeight="Bold" Foreground="#333"/>
            <TextBlock Text="{Binding BonjourUser}" FontSize="16" Foreground="#B8860B" VerticalAlignment="Bottom" Margin="20,0,0,4"/>

            <Border Background="#E8F5E9" CornerRadius="5" Margin="50,0,0,0" Padding="10,2">
                <TextBlock Text="{Binding CoutTotal, StringFormat='Valorisation Totale : {0:C2}'}"
                           FontSize="16" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="TabControl_SelectionChanged" Margin="6,40,-6,-12" Grid.RowSpan="2">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="15,10"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="GESTION DU STOCK">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,20,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="0,0,0,10" Background="White" CornerRadius="15" BorderBrush="#DDD" BorderThickness="1" Height="35">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rechercher" Margin="10,0,5,0" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBox x:Name="SearchBox" Text="{Binding TexteRecherche, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="14"/>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding ListeBouteilles}" SelectedItem="{Binding SelectedBouteille}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="White" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                                    <DataGridTextColumn Header="Vin" Binding="{Binding Libelle}" Width="*"/>    
                                    <DataGridTextColumn Header="Millesime" Binding="{Binding Millesime}" Width="70"/>
                                    <DataGridTextColumn Header="Emplacement" Binding="{Binding Code_Emplacement}" Width="100" FontWeight="Bold" Foreground="#B8860B"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="ACTION : DEPLACER" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

                            <TextBlock Text="Vin selectionne :" FontSize="12" Foreground="Gray"/>
                            <Border Background="#F9F9F9" Padding="10" Margin="0,5,0,20" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedBouteille.Libelle, TargetNullValue='---'}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedBouteille.Code_Emplacement, StringFormat='Actuel : {0}', TargetNullValue='Loc: ---'}" Foreground="#B8860B"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Nouvel ID Emplacement :" FontSize="12" Foreground="Gray"/>
                            <TextBox Text="{Binding TargetEmplacementId, UpdateSourceTrigger=PropertyChanged}" Height="40" FontSize="16" FontWeight="Bold" Padding="5" VerticalContentAlignment="Center" BorderBrush="#DDD" BorderThickness="1" Margin="0,5,0,20"/>

                            <Button Command="{Binding DeplacerCommand}" Content="CONFIRMER" Height="45" Background="#B8860B" Foreground="White" FontWeight="Bold"/>
                            <Button Command="{Binding RefreshCommand}" Content="Actualiser" Height="30" Margin="0,10,0,0" Background="Transparent" Foreground="Gray" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="ZONES ET VALEURS">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,20,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="VALORISATION PAR EMPLACEMENT" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding ListeStatsZones}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="White" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Zone / Emplacement" Binding="{Binding ZoneComplete}" Width="*" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Quantite" Binding="{Binding Quantite}" Width="80"/>
                                    <DataGridTextColumn Header="Valeur Totale" Binding="{Binding ValeurTotale, StringFormat=C2}" Width="100" Foreground="#2E7D32" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="AJOUTER UNE NOUVELLE ZONE" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

                            <TextBlock Text="Nom de l'emplacement :" 
                       Grid.Column="0"
                       FontSize="16" 
                       VerticalAlignment="Center" 
                       Margin="0,0,15,0"/>

                            <TextBox Text="{Binding NomEmplacement, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Capacité de l'emplacement :" 
  Grid.Column="0"
  FontSize="16" 
  VerticalAlignment="Center" 
  Margin="0,0,15,0"/>
                            <TextBox Text="{Binding Capacite, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Zone de l'emplacement :" 
  Grid.Column="0"
  FontSize="16" 
  VerticalAlignment="Center" 
  Margin="0,0,15,0"/>
                            <TextBox Text="{Binding Zone, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding CreerEmplacementCommand}"
        Content="CREER L'EMPLACEMENT"
        Height="45"
        Background="#333"
        Foreground="White"
        FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="RESERVATIONS">
                <Border Background="White" CornerRadius="8" Padding="40" Margin="0,15,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="MODULE DE RESERVATION" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ici, le sommelier pourra mettre de cote des bouteilles pour un service futur." Foreground="Gray" Margin="0,10,0,20" HorizontalAlignment="Center"/>
                        <Button Content="Nouvelle Reservation" Width="200" Height="40" Background="#B8860B" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2"
                Content="Retour"
                Background="Transparent"
                Foreground="#B8860B"
                BorderThickness="0"
                FontSize="14"
                HorizontalAlignment="Right"
                Margin="0,8,0,0"
                Cursor="Hand"
                Click="RetourButton_Click"/>
    </Grid>
</Window>
 