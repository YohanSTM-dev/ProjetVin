<Window x:Class="ProjetCaveVin.View.StatistiquesGrandMonarqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetCaveVin.ViewModel"
        mc:Ignorable="d"
        Title="StatistiquesGrandMonarqueWindow" Height="450" Width="800">

    <Grid>
        <TextBlock Text="etat des Stocks" 
           FontSize="20" FontWeight="Bold" Margin="0,20,0,10" 
           Foreground="#333" HorizontalAlignment="Center"/>

        <Border Background="White" CornerRadius="10" Padding="10" Margin="20" Effect="{DynamicResource MaterialDesignShadowDepth1}">
            <ListView ItemsSource="{Binding StocksParBouteille}" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Key}" 
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               Foreground="Black" 
                               TextTrimming="CharacterEllipsis"/>

                            <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="5" Padding="10,2">
                                <TextBlock Text="{Binding Value}" 
                                   FontWeight="Bold" 
                                   FontSize="16" 
                                   Foreground="#B8860B"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Window>