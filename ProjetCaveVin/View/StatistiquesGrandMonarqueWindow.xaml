<Window x:Class="ProjetCaveVin.View.StatistiquesGrandMonarqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetCaveVin.ViewModel"
        mc:Ignorable="d"
        Title="Statistiques Grand Monarque" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock Text="Valorisation Totale de la Cave" 
                           FontSize="18" Foreground="Gray" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CoutTotal, StringFormat=C2}" 
                           FontSize="36" FontWeight="Bold" Foreground="#B8860B" HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Detail par Bouteille" 
                       FontSize="20" FontWeight="Bold" Margin="0,0,0,10" 
                       Foreground="#333"/>

            <Border Background="White" CornerRadius="10" Padding="5" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="320" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                </Border.Effect>

                <ListView ItemsSource="{Binding StocksParBouteille}" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Key}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="10" Padding="10,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Value}" FontWeight="Bold" Foreground="#B8860B"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <TextBlock Text="Repartition par Type" 
                       FontSize="20" FontWeight="Bold" Margin="0,10,0,10" 
                       Foreground="#333"/>

            <Border Background="White" CornerRadius="10" Padding="5" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Direction="320" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
                </Border.Effect>

                <ListView ItemsSource="{Binding RepartitionParType}" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Key}" FontSize="14" VerticalAlignment="Center"/>

                                <Border Grid.Column="1" Background="#E0F7FA" CornerRadius="10" Padding="10,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Value}" FontWeight="Bold" Foreground="#006064"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>


			<TextBlock Text="Historique des Deplacemeny bouteille"
                       FontSize="20" FontWeight="Bold" Margin="0,20,0,10"
                       Foreground="#333"/>

			<Border Background="White" CornerRadius="10" Padding="5" Margin="0,0,0,20">
				<Border.Effect>
					<DropShadowEffect Color="Black" Direction="320" ShadowDepth="2" Opacity="0.2" BlurRadius="5"/>
				</Border.Effect>

				<ListView ItemsSource="{Binding HistoriqueList}" BorderThickness="0" Height="200">
					<ListView.ItemTemplate>
						<DataTemplate>
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="120"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<TextBlock Text="{Binding DateDeplacement, StringFormat={}{0:dd/MM HH:mm}}"
                                           FontSize="12" Foreground="Gray"
                                           VerticalAlignment="Center"/>

								<TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14">
									<Run Text="Utilisateur"/>
									<Run Text="{Binding IdUtilisateur}" FontWeight="Bold" Foreground="#B8860B"/>
									<Run Text=": Bouteille"/>
									<Run Text="{Binding IdBouteille}" FontWeight="Bold" Foreground="#B8860B"/>
									<Run Text="vers Emp."/>
									<Run Text="{Binding IdEmplacement}" FontWeight="Bold" Foreground="#B8860B"/>
								</TextBlock>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Border>

        </StackPanel>
    </ScrollViewer>
</Window>